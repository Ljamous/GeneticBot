# ==============================================================================
# GeneticBot Application - Central Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your values:
#   copy .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# OpenAI API Configuration
# ------------------------------------------------------------------------------
# Set your OpenAI API key here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# Database Configuration (MySQL)
# ------------------------------------------------------------------------------
# For local execution outside Docker: DB_HOST=localhost
# For Docker Compose: DOCKER_DB_HOST=db
DB_HOST=localhost
DOCKER_DB_HOST=db
DB_PORT=3306
DB_EXTERNAL_PORT=3307
DB_USER=db_user
DB_PASSWORD=db_password
DB_NAME=app_db
MYSQL_ROOT_PASSWORD=db_password

# ------------------------------------------------------------------------------
# Medical Analysis Service (FastAPI) Configuration
# ------------------------------------------------------------------------------
PROJECT_NAME="Medical Analysis"
DESCRIPTION="Medical Analysis API"
HOST=0.0.0.0
PORT=8000
DEBUG=true
VERSION="1.0.0"
SECRET_KEY="your_secret_key_here"
LOG_LEVEL="INFO"

# ------------------------------------------------------------------------------
# Service Ports
# ------------------------------------------------------------------------------
SYSTEM_PORT=80
MEDICAL_ANALYSIS_PORT=8000
PEDIGREE_PORT=8001
GENETIC_BOT_PORT=8501
